# Use URL-safe passwords because these values are embedded in connection URLs.
POSTGRES_USER=root
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password
REDIS_PASSWORD=replace_with_a_long_password
SESSION_SECRET=replace_with_at_least_32_random_bytes

PUBLIC_PORT=443
TZ=Asia/Shanghai
NODE_NAME=new-api-node-1

# Used only by docker-compose.host-db.yml. These defaults let the Docker
# application share PostgreSQL and Redis already published by the host.
HOST_DB_PUBLIC_PORT=443
EXISTING_SERVICES_HOST=host.docker.internal
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_DB_NODE_NAME=docker-host-db-node
GATEWAY_TLS_CERT_DIR=./certs
GATEWAY_TLS_CERT_FILE=/certs/fullchain.pem
GATEWAY_TLS_KEY_FILE=/certs/privkey.pem
HOST_DB_SESSION_COOKIE_SECURE=true
HOST_DB_SESSION_COOKIE_TRUSTED_URL=https://api.example.com

# Complete Docker HTTPS deployment (docker-compose.prod.yml):
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://api.example.com
TRUSTED_PROXIES=

# Images pulled by both Docker deployment Compose files. Change these only
# when deploying a fixed version tag or a different Docker Hub namespace.
APP_IMAGE=jingquanliang/new-api-platform:latest
GATEWAY_IMAGE=jingquanliang/new-api-platform-gateway:latest
